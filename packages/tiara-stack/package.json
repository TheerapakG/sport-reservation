{
  "name": "tiara-stack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tiara": "./dist/scripts.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier -c .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "generate": "vite build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "citty": "^0.1.6",
    "consola": "^3.4.0",
    "defu": "^6.1.4",
    "rollup": "^4.32.0",
    "scule": "^1.3.0"
  },
  "peerDependencies": {
    "@ark/util": "catalog:",
    "@openauthjs/openauth": "catalog:",
    "arktype": "catalog:",
    "c12": "catalog:",
    "destr": "catalog:",
    "effect": "catalog:",
    "h3": "catalog:",
    "hookable": "^5.5.3",
    "nitropack": "catalog:",
    "ofetch": "catalog:",
    "pathe": "catalog:",
    "ufo": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@types/eslint__eslintrc": "catalog:",
    "@types/eslint__js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "glob": "^11.0.1",
    "globals": "catalog:",
    "prettier": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
