{
  "name": "sport-reservation-upload",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/.theestack/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier -c .",
    "lint": "eslint --flag unstable_ts_config .",
    "typecheck": "tsc --noEmit",
    "build": "theestack client build",
    "dev": "nitro dev",
    "generate": "theestack client generate",
    "preview": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/lib-storage": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/schema": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-drizzle": "catalog:",
    "@effect/sql-pg": "catalog:",
    "jsonwebtoken": "catalog:",
    "unstorage": "^1.10.2",
    "validator": "^13.12.0"
  },
  "peerDependencies": {
    "arktype": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "h3": "catalog:",
    "ofetch": "catalog:",
    "sport-reservation-common": "workspace:*",
    "ufo": "catalog:"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@smithy/types": "^3.5.0",
    "@types/eslint__eslintrc": "catalog:",
    "@types/eslint__js": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "jiti": "catalog:",
    "nitropack": "catalog:",
    "pathe": "catalog:",
    "prettier": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
