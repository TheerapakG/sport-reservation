// https://nitro.unjs.io/guide/typescript
{
  "extends": "./.nitro/types/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#imports": ["./.nitro/types/nitro-imports"],
      "~/*": ["./server/*"],
      "@/*": ["./server/*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"],
      "$/*": ["./.theestack/*"]
    }
  }
}
